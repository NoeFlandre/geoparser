+from contextlib import contextmanager
 from pathlib import Path
 
 import pytest
@@ -308,3 +310,78 @@ def test_architecture_help_describes_the_package_option(tmp_path: Path) -> None:
     )
     assert "--package PACKAGE" in result.stdout
     assert result.stderr == ""
+
+
+# --- build_parser() ---------------------------------------------------------
+
+# Audit events that mean the process read, wrote, created, listed or moved a
+# file or directory. Stat-only lookups such as Path.exists() change nothing on
+# disk and are deliberately not counted.
+_SIDE_EFFECT_EVENTS = frozenset(
+    {
+        "open",
+        "os.chdir",
+        "os.chmod",
+        "os.link",
+        "os.listdir",
+        "os.mkdir",
+        "os.remove",
+        "os.rename",
+        "os.rmdir",
+        "os.scandir",
+        "os.symlink",
+        "os.utime",
+    }
+)
+_active_watchers: list[list[str]] = []
+
+
+def _note_filesystem_event(event: str, args: tuple[object, ...]) -> None:
+    if _active_watchers and event in _SIDE_EFFECT_EVENTS:
+        _active_watchers[-1].append(f"{event} {args!r}")
+
+
+sys.addaudithook(_note_filesystem_event)
+
+
+@contextmanager
+def _filesystem_events() -> Iterator[list[str]]:
+    """Collect every filesystem side effect raised while the block runs."""
+    events: list[str] = []
+    _active_watchers.append(events)
+    try:
+        yield events
+    finally:
+        _active_watchers.pop()
+
+
+@pytest.mark.parametrize(
+    ("module", "argv", "expected"),
+    [
+        (changelog, ["1.0.0"], {"tag": "1.0.0", "changelog": Path("CHANGELOG.md")}),
+        (
+            changelog,
+            ["1.0.0rc1", "--changelog", "notes/CHANGELOG.md"],
+            {"tag": "1.0.0rc1", "changelog": Path("notes/CHANGELOG.md")},
+        ),
+        (check_architecture, [], {"package": Path("geoparser")}),
+        (
+            check_architecture,
+            ["--package", "src/geoparser"],
+            {"package": Path("src/geoparser")},
+        ),
+    ],
+)
+def test_build_parser_parses_the_documented_defaults_without_filesystem_access(
+    module, argv: list[str], expected: dict[str, object]
+) -> None:
+    with _filesystem_events() as events:
+        args = module.build_parser().parse_args(argv)
+
+    assert events == []
+    assert vars(args) == expected
+
+
+@pytest.mark.parametrize("module", [changelog, check_architecture])
+def test_build_parser_keeps_the_module_docstring_as_its_description(module) -> None:
+    assert module.build_parser().description == module.__doc__
